local function hideDefaultShiftlock(hide)
    pcall(function()
        local robloxGui = CoreGui:FindFirstChild("RobloxGui") or LocalPlayer.PlayerGui
        for _, v in pairs(robloxGui:GetDescendants()) do
            if v:IsA("ImageLabel") and (v.Name == "ShiftLockCursor" or v.Name == "MouseIcon") then
                v.ImageTransparency = hide and 1 or 0
