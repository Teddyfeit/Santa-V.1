--[=[
    KeySystem  (v3.4) - LinoriaLib-styled

    Same flow as before. A saved key is checked automatically on start
    and the panel only appears when there isn't a valid one:
      - keys are fetched from the raw GitHub URL
      - a valid key is written to key.txt so the UI is skipped next run
      - an invalid saved key is deleted
      - success runs ScriptToRun(), failure leaves the panel open

    The visuals are taken from LinoriaLib's own Library.lua, not from
    memory. Verified against the source:
      Font          Enum.Font.Code
      FontColor     rgb(255, 255, 255)
      MainColor     rgb(28, 28, 28)     window body
      BackgroundColor rgb(20, 20, 20)   inputs, tab buttons
      AccentColor   rgb(0, 85, 255)     window border
      OutlineColor  rgb(50, 50, 50)     element borders
      RiskColor     rgb(255, 50, 50)
      TextSize      16
      Corners       none. LinoriaLib creates zero UICorner instances.
      Text stroke   black UIStroke, thickness 1, Miter line join,
                    TextStrokeTransparency 1 (the stroke does the work)
      Window shell  pure black outer frame, 1px inset accent border
      Drop shadow   none. LinoriaLib does not create one.

    Known deviation: the real library parents its ScreenGui to CoreGui.
    This parents to PlayerGui with ResetOnSpawn = false, which is the
    supported way to survive a respawn. CoreGui is reserved for
    Roblox's own scripts and ResetOnSpawn does nothing there.

    v3.2 changes:
      - Shadow and Blur frames deleted. They were the only elements
        outside the Inner frame, and a stray dark layer over the whole
        window is indistinguishable from "the panel is black".
      - The whole UI build runs inside pcall, and every element prints
        as it is created. If the window comes up empty, the output panel
        now says exactly which element was the last one that worked,
        instead of leaving us to guess from the picture.

    v3.3 changes:
      - FIXED the real cause of the empty black window. MakeDraggable
        connected frame.InputMoved, which is not a valid member of a
        GuiObject, so it threw one line after the black Outer frame was
        created. Replaced with InputChanged, which is the event that
        actually fires while a button is held down.
]=]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

-- Configuration
local function decode(t)
    local s = ""
    for _, v in ipairs(t) do
        s = s .. string.char(v)
    end
    return s
end

local KeyURL = decode({104, 116, 116, 112, 115, 58, 47, 47, 114, 97, 119, 46, 103, 105, 116, 104, 117, 98, 117, 115, 101, 114, 99, 111, 110, 116, 101, 110, 116, 46, 99, 111, 109, 47, 84, 101, 100, 100, 121, 102, 101, 105, 116, 47, 115, 114, 121, 45, 98, 114, 111, 45, 105, 100, 107, 45, 119, 104, 97, 116, 45, 116, 102, 45, 105, 109, 45, 100, 111, 110, 103, 47, 114, 101, 102, 115, 47, 104, 101, 97, 100, 115, 47, 109, 97, 105, 110, 47, 107, 101, 121, 115, 46, 116, 120, 116}) -- Ersetze dies mit deinem Raw GitHub Link
local SaveFileName = "santa_v1_key.txt" -- Name der lokalen Speicherdatei

local ScriptToRun = function()
    -- Hier kommt das Skript rein, das bei erfolgreichem Key ausgeführt werden soll
    print("Loading Script...")
    -- ── TeddyHub.lua ───────────────────────────────────
