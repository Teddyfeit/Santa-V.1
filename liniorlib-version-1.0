local ShiftLockSystem = {
    Enabled = false,
    CurrentID = "6031075931",
    IconSize = 32
}

local ShiftPresets = {
    ["Clean White Dot"]   = "6031075931",
    ["Red Dot"]           = "6830874135",
    ["Crosshair Small"]   = "138380362",
    ["Crosshair Large"]   = "254508119",
    ["Circle Scope"]      = "3523723128",
    ["Purple Crosshair"]  = "6031075931",
    ["Target Scope"]      = "5820712980"
}

local ShiftPresetNames = {}
for name, _ in pairs(ShiftPresets) do
    table.insert(ShiftPresetNames, name)
end

local CrosshairGui = Instance.new("ScreenGui")
CrosshairGui.Name = "CustomShiftlockOverlay"
CrosshairGui.ResetOnSpawn = false

pcall(function() CrosshairGui.Parent = CoreGui end)
if not CrosshairGui.Parent then
    CrosshairGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
end

local CrosshairImage = Instance.new("ImageLabel")
CrosshairImage.Name = "CursorImage"
CrosshairImage.AnchorPoint = Vector2.new(0.5, 0.5)
CrosshairImage.BackgroundTransparency = 1
CrosshairImage.Size = UDim2.new(0, 32, 0, 32)
CrosshairImage.Visible = false
CrosshairImage.Parent = CrosshairGui

local function hideDefaultShiftlock(hide)
    pcall(function()
        local robloxGui = CoreGui:FindFirstChild("RobloxGui") or LocalPlayer.PlayerGui
        for _, v in pairs(robloxGui:GetDescendants()) do
            if v:IsA("ImageLabel") and (v.Name == "ShiftLockCursor" or v.Name == "MouseIcon") then
                v.ImageTransparency = hide and 1 or 0
            end
        end
    end)
end

RunService.RenderStepped:Connect(function()
    if not ShiftLockSystem.Enabled then
        CrosshairImage.Visible = false
        hideDefaultShiftlock(false)
        return
    end

    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
        hideDefaultShiftlock(true)
        
        local viewSize = workspace.CurrentCamera.ViewportSize
        CrosshairImage.Position = UDim2.new(0, viewSize.X / 2, 0, viewSize.Y / 2)
        
        local cleanId = tostring(ShiftLockSystem.CurrentID):gsub("%D", "")
        CrosshairImage.Image = "rbxassetid://" .. cleanId
        CrosshairImage.Size = UDim2.new(0, ShiftLockSystem.IconSize, 0, ShiftLockSystem.IconSize)
        CrosshairImage.Visible = true
    else
        CrosshairImage.Visible = false
        hideDefaultShiftlock(false)
    end
end)

