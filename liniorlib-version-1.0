local targetHudEnabled = false

local function updateTargetHUD(targetPlayer)
    if not targetHudEnabled or not targetPlayer or not targetPlayer.Character then
        TargetFrame.Visible = false
        return
    end

    local humanoid = targetPlayer.Character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        TargetFrame.Visible = false
        return
    end

    TargetFrame.Visible = true
    NameLabel.Text = targetPlayer.DisplayName or targetPlayer.Name
    AvatarImage.Image = "https://www.roblox.com/headshot-thumbnail/image?userId=" .. targetPlayer.UserId .. "&width=150&height=150&format=png"

    local health = math.floor(humanoid.Health)
    local maxHealth = math.floor(humanoid.MaxHealth)
    local healthPercent = math.clamp(health / maxHealth, 0, 1)

    HealthLabel.Text = health .. " / " .. maxHealth .. " HP"
    HealthBarFill.Size = UDim2.new(healthPercent, 0, 1, 0)

    if healthPercent > 0.5 then
        HealthBarFill.BackgroundColor3 = Color3.fromRGB(0, 255, 120)
    elseif healthPercent > 0.25 then
        HealthBarFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    else
        HealthBarFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    end
end

-- ── Crosshair Variables Forward-Declaration ──────────────────────
local currentCHPosition = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

-- ── Aimbot ────────────────────────────────────────────────────────
local hue                = 0
local rainbowFov         = false
local rainbowSpeed       = 0.005
local aimFov             = 100
local aiming             = false
local predictionStr      = 0.065
local smoothing          = 0.05
local aimbotEnabled      = false
local wallCheck          = true
local stickyAim          = false
local teamCheck          = false
local healthCheck        = false
local minHealth          = 0
local circleColor        = Color3.fromRGB(255, 192, 253)
local targetedColor      = Color3.fromRGB(250, 139, 255)
local currentTarget      = nil
local linkFovToCrosshair = false

local fovCircle = Drawing.new('Circle')
fovCircle.Thickness = 2
fovCircle.Radius    = aimFov
fovCircle.Filled    = false
fovCircle.Color     = circleColor
fovCircle.Visible   = false

local function isTeammate(p)
    return teamCheck and p.Team == LocalPlayer.Team
end

local function wallBlocked(char)
    local head = char:FindFirstChild('Head')
    if not head then return true end
    local origin = Camera.CFrame.Position
    local dir    = (head.Position - origin).Unit * (head.Position - origin).Magnitude
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = { LocalPlayer.Character, char }
    params.FilterType = Enum.RaycastFilterType.Exclude
    local result = workspace:Raycast(origin, dir, params)
    return result ~= nil
end

local function getAimbotTarget()
    local best, bestCursor, bestDist = nil, aimFov, math.huge
    local camPos = Camera.CFrame.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer or not p.Character then continue end
        local head = p.Character:FindFirstChild('Head')
        local hum  = p.Character:FindFirstChildOfClass('Humanoid')
        if not head or not hum then continue end
        if isTeammate(p) then continue end
        if healthCheck and hum.Health < minHealth then continue end
        local sp = Camera:WorldToViewportPoint(head.Position)
        if sp.Z <= 0 then continue end
        local screenPos  = Vector2.new(sp.X, sp.Y)
        local cursorDist = (screenPos - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
        local playerDist = (head.Position - camPos).Magnitude
        if cursorDist < bestCursor and (not wallCheck or not wallBlocked(p.Character)) then
            if playerDist < bestDist then
                bestDist = playerDist; bestCursor = cursorDist; best = p
            end
        end
    end
    return best
end

local function aimAt(p)
    local head = p.Character and p.Character:FindFirstChild('Head')
    local hrp  = p.Character and p.Character:FindFirstChild('HumanoidRootPart')
    if not head or not hrp then return end
    local predicted = head.Position + hrp.Velocity * predictionStr
    local target    = CFrame.new(Camera.CFrame.Position, predicted)
    Camera.CFrame   = Camera.CFrame:Lerp(target, smoothing)
end

RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        if linkFovToCrosshair and currentCHPosition then
            fovCircle.Position = currentCHPosition
        else
            fovCircle.Position = Vector2.new(Mouse.X, Mouse.Y + 50)
        end

        if rainbowFov then
            hue = (hue + rainbowSpeed) % 1
            fovCircle.Color = Color3.fromHSV(hue, 1, 1)
        else
            fovCircle.Color = (aiming and currentTarget) and targetedColor or circleColor
        end
        if aiming then
            if stickyAim and currentTarget then
                local sp = Camera:WorldToViewportPoint(currentTarget.Character.Head.Position)
                local d  = (Vector2.new(sp.X, sp.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                if d > aimFov or (wallCheck and wallBlocked(currentTarget.Character)) or isTeammate(currentTarget) then
                    currentTarget = nil
                end
            end
            if not stickyAim or not currentTarget then currentTarget = getAimbotTarget() end
            if currentTarget then aimAt(currentTarget) end
        else
            currentTarget = nil
        end
    end

    updateTargetHUD(currentTarget)
end)

Mouse.Button2Down:Connect(function() if aimbotEnabled then aiming = true  end end)
Mouse.Button2Up:Connect(function()   if aimbotEnabled then aiming = false end end)

-- ── Triggerbot ────────────────────────────────────────────────────
local trigger = { enabled=false, teamCheck=false, delay=0, holdMode=false, clickInterval=0.05 }
local lastClick = 0

local function getTriggerTarget()
    local t = Mouse.Target
    if not t or not t.Parent then return nil end
    local char = t.Parent
    if not char:FindFirstChild('Humanoid') then return nil end
    local p = Players:GetPlayerFromCharacter(char)
    if not p or p == LocalPlayer then return nil end
    if trigger.teamCheck and p.Team == LocalPlayer.Team then return nil end
    return p
end

RunService.RenderStepped:Connect(function()
    if not trigger.enabled then return end
    local can = not trigger.holdMode or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if can and getTriggerTarget() and (tick() - lastClick) >= (trigger.delay + trigger.clickInterval) then
        lastClick = tick()
        if mouse1click then
            mouse1click()
        else
            VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true, game, 0)
            VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 0)
        end
    end
end)

-- ── SpinBot & Anti-Aim System ───────────────────────────────────
local spinEnabled = false
local spinSpeed = 10

local antiAim = {
    enabled = false,
    velocityDesync = false,
    veloX = 0, veloY = 1000, veloZ = 0,
    jitter = false,
    jitterRange = 5,
    pitch = 0,
    yaw = 0,
    roll = 0
}

RunService.RenderStepped:Connect(function(deltaTime)
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild('HumanoidRootPart')
    local hum = char and char:FindFirstChildOfClass('Humanoid')

    if hum and (spinEnabled or antiAim.enabled) then
        hum.AutoRotate = false
    elseif hum and not spinEnabled and not antiAim.enabled then
        hum.AutoRotate = true
    end

    if spinEnabled and root then
        root.CFrame = root.CFrame * CFrame.Angles(0, math.rad(spinSpeed), 0)
    end
    
    if antiAim.enabled and root then
        local angleCFrame = CFrame.Angles(math.rad(antiAim.pitch), math.rad(antiAim.yaw), math.rad(antiAim.roll))
        root.CFrame = root.CFrame * angleCFrame
        
        if antiAim.jitter then
            local offset = Vector3.new(
                (math.random() - 0.5) * antiAim.jitterRange,
                0,
                (math.random() - 0.5) * antiAim.jitterRange
            )
            root.CFrame = root.CFrame + offset
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if antiAim.enabled and antiAim.velocityDesync then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild('HumanoidRootPart')
        if root then
            local oldVelo = root.Velocity
            root.Velocity = Vector3.new(antiAim.veloX, antiAim.veloY, antiAim.veloZ)
            RunService.RenderStepped:Wait()
            root.Velocity = oldVelo
        end
    end
end)

-- ── ESP Engine ───────────────────────────────────────────────────
local ESPToggles = {
    master=false, box=true, fill=false, name=true,
    distance=true, weapon=false, healthbar=true,
    skeleton=false, skeletonOutline=false,
}
local ESPOptions = {
    boundsType='static', boundsScale=100,
    color=Color3.fromRGB(0, 255, 140),
}

local SKEL_PARTS = {
    'RightHand','LeftLowerArm','RightLowerArm','LeftUpperArm','RightUpperArm',
    'LowerTorso','LeftLowerLeg','LeftUpperLeg','LeftFoot','RightFoot',
    'RightLowerLeg','RightUpperLeg','UpperTorso','LeftHand','Head',
}
local SKEL_LINES = {
    {'LeftUpperArm','UpperTorso'},   {'LeftLowerArm','LeftUpperArm'},
    {'LeftLowerArm','LeftHand'},     {'RightUpperArm','UpperTorso'},
    {'RightLowerArm','RightUpperArm'},{'RightHand','RightLowerArm'},
    {'LeftUpperLeg','LowerTorso'},   {'LeftLowerLeg','LeftUpperLeg'},
    {'LeftFoot','LeftLowerLeg'},     {'RightUpperLeg','LowerTorso'},
    {'RightLowerLeg','RightUpperLeg'},{'RightFoot','RightLowerLeg'},
    {'LowerTorso','UpperTorso'},
}

local ESP = {}; ESP.__index = ESP
function ESP.new() return setmetatable({ players={} }, ESP) end

function ESP:createState(player)
    local s = { player=player, character=nil, humanoid=nil, humanoidRootPart=nil,
                parts={}, connections={}, drawings={}, squares={}, lines={}, text={} }
    for i=1,26 do
        local l=Drawing.new('Line'); l.Visible=false; l.Thickness=1; l.Color=Color3.new(1,1,1)
        table.insert(s.drawings,l); table.insert(s.lines,l)
    end
    for i=1,4 do
        local t=Drawing.new('Text'); t.Outline=true; t.Visible=false
        t.Color=Color3.new(1,1,1); t.Center=true; t.Size=13
        table.insert(s.drawings,t); table.insert(s.text,t)
    end
    for i=1,4 do
        local sq=Drawing.new('Square'); sq.Visible=false; sq.Outline=false
        table.insert(s.drawings,sq); table.insert(s.squares,sq)
    end
    s.squares[1].Thickness=1; s.squares[1].Color=Color3.new(0,0,0)
    s.squares[2].Thickness=1; s.squares[3].Filled=true
    s.squares[4].Filled=true; s.squares[4].Color=Color3.new(0,0,0)
    return s
end

function ESP:updateState(player, char)
    local s = self.players[player]; if not s then return end
    s.character=char
    s.humanoidRootPart=char:WaitForChild('HumanoidRootPart',5)
    s.humanoid=char:WaitForChild('Humanoid',5)
    s.parts={}
    if not s.humanoid or not s.humanoidRootPart then return end
    for _,n in ipairs(SKEL_PARTS) do
        local p=char:FindFirstChild(n); if p then s.parts[n]=p end
    end
end

function ESP:bounds(s)
    local hrp=s.humanoidRootPart; if not hrp then return nil end
    local top,ton=Camera:WorldToViewportPoint((hrp.CFrame*CFrame.new(0,3,0)).Position)
    local bot,bon=Camera:WorldToViewportPoint((hrp.CFrame*CFrame.new(0,-3.5,0)).Position)
    if not ton and not bon then return nil end
    local h=math.abs(top.Y-bot.Y)
    local w=h*0.6*(ESPOptions.boundsScale/100)
    return w,h,Vector2.new(top.X,top.Y)
end

function ESP:drawSkeleton(s)
    for _,l in ipairs(s.lines) do l.Visible=false end
    if not ESPToggles.skeleton or not s.character then return end
    for i,pair in ipairs(SKEL_LINES) do
        local fP=s.parts[pair[1]]; local tP=s.parts[pair[2]]
        if not fP or not tP then continue end
        local f,onF=Camera:WorldToViewportPoint(fP.Position)
        local t,onT=Camera:WorldToViewportPoint(tP.Position)
        if not onF or not onT then continue end
        local l=s.lines[i]; l.From=Vector2.new(f.X,f.Y); l.To=Vector2.new(t.X,t.Y)
        l.Color=ESPOptions.color; l.Thickness=ESPToggles.skeletonOutline and 2 or 1; l.Visible=true
    end
end

function ESP:drawBox(s,w,h,pos)
    s.squares[1].Visible=false; s.squares[2].Visible=false
    if not ESPToggles.box then return end
    local sz=Vector2.new(w,h); local p=pos-Vector2.new(w/2,0)
    s.squares[2].Size=sz; s.squares[2].Position=p
    s.squares[2].Color=ESPOptions.color; s.squares[2].Filled=ESPToggles.fill; s.squares[2].Visible=true
end

function ESP:drawText(s,w,h,pos)
    for _,t in ipairs(s.text) do t.Visible=false end
    local topPos=pos-Vector2.new(0,15); local botPos=pos+Vector2.new(0,h+2)
    if ESPToggles.name then
        s.text[1].Text=s.player.Name; s.text[1].Position=topPos
        s.text[1].Color=ESPOptions.color; s.text[1].Visible=true
    end
    if ESPToggles.weapon then
        local item=s.character and (s.character:FindFirstChildOfClass('Tool') or s.character:FindFirstChild('EquippedItem'))
        s.text[2].Text=item and item.Name or 'None'; s.text[2].Position=botPos
        s.text[2].Color=ESPOptions.color; s.text[2].Visible=true; botPos=botPos+Vector2.new(0,14)
    end
    if ESPToggles.distance and s.humanoidRootPart then
        local d=math.round((s.humanoidRootPart.Position-Camera.CFrame.Position).Magnitude)
        s.text[3].Text='['..d..'m]'; s.text[3].Position=botPos
        s.text[3].Color=ESPOptions.color; s.text[3].Visible=true
    end
end

function ESP:drawHealthbar(s,w,h,pos)
    s.squares[3].Visible=false; s.squares[4].Visible=false
    if not ESPToggles.healthbar or not s.humanoid then return end
    local ratio=math.clamp(s.humanoid.Health/s.humanoid.MaxHealth,0,1)
    local barH=h*ratio
    local barPos=pos-Vector2.new(w/2+6,-h+barH)
    local bgPos=pos-Vector2.new(w/2+6,0)
    s.squares[4].Size=Vector2.new(3,h); s.squares[4].Position=bgPos; s.squares[4].Visible=true
    s.squares[3].Size=Vector2.new(3,barH); s.squares[3].Position=barPos
    s.squares[3].Color=Color3.fromRGB(255,0,0):Lerp(Color3.fromRGB(0,255,0),ratio); s.squares[3].Visible=true
end

function ESP:hideAll(s) for _,d in ipairs(s.drawings) do d.Visible=false end end

function ESP:update(player)
    local s=self.players[player]; if not s then return end
    if not ESPToggles.master then self:hideAll(s) return end
    local char=s.character
    if not char or not s.humanoidRootPart or not s.humanoid or s.humanoid.Health<=0 then self:hideAll(s) return end
    if player==LocalPlayer then self:hideAll(s) return end
    local w,h,pos=self:bounds(s); if not w then self:hideAll(s) return end
    self:drawSkeleton(s); self:drawBox(s,w,h,pos); self:drawText(s,w,h,pos); self:drawHealthbar(s,w,h,pos)
end

function ESP:start()
    local function onAdded(player)
        local s=self:createState(player); self.players[player]=s
        local function onChar(char) task.spawn(function() self:updateState(player,char) end) end
        table.insert(s.connections, player.CharacterAdded:Connect(onChar))
        table.insert(s.connections, player.CharacterRemoving:Connect(function() self:hideAll(s); s.character=nil end))
        if player.Character then onChar(player.Character) end
    end
    for _,p in ipairs(Players:GetPlayers()) do onAdded(p) end
    Players.PlayerAdded:Connect(onAdded)
    Players.PlayerRemoving:Connect(function(player)
        local s=self.players[player]; if not s then return end
        for _,c in ipairs(s.connections) do pcall(c.Disconnect,c) end
        for _,d in ipairs(s.drawings)    do pcall(d.Remove,d)     end
        self.players[player]=nil
    end)
    RunService.RenderStepped:Connect(function() for p in pairs(self.players) do self:update(p) end end)
end

local ESPEngine = ESP.new(); ESPEngine:start()

-- ── Crosshair ─────────────────────────────────────────────────────
local CH = {
    Visible=false, SpinSpeed=0.005, CentralGap=8, TotalLength=112,
    LineThickness=2, OutlineThickness=4,
    ColorStart=Color3.fromRGB(180,180,180), ColorEnd=Color3.fromRGB(20,20,20),
    CircleVisible=true, CircleRadius=119, CircleTransparency=0.3,
    CircleColor=Color3.fromRGB(15,15,25),
    TrackingEnabled=false, TrackingRadius=150, TrackingSmoothness=0.2, TrackPart='Head', TeamCheck=true,
}

local SEG = 2
local chLines, chOutlines, chCircle = {}, {}, nil

local function clearCH()
    if chCircle then chCircle:Remove(); chCircle=nil end
    for arm=1,#chLines do
        if chLines[arm] then
            for seg=1,#chLines[arm] do
                if chLines[arm][seg]    then chLines[arm][seg]:Remove()    end
                if chOutlines[arm][seg] then chOutlines[arm][seg]:Remove() end
            end
        end
    end
    chLines, chOutlines = {}, {}
end

local function initCH()
    clearCH()
    chCircle = Drawing.new('Circle')
    chCircle.Filled=true; chCircle.NumSides=64; chCircle.Radius=CH.CircleRadius
    chCircle.Color=CH.CircleColor; chCircle.Transparency=CH.CircleTransparency
    chCircle.Visible=CH.Visible and CH.CircleVisible
    local segs=math.max(1,math.floor(CH.TotalLength/SEG))
    for arm=1,4 do
        chLines[arm], chOutlines[arm] = {}, {}
        for seg=1,segs do
            local p=(seg-0.5)/segs
            local ol=Drawing.new('Line'); ol.Thickness=CH.OutlineThickness; ol.Color=Color3.new(0,0,0); ol.Visible=CH.Visible
            local ml=Drawing.new('Line'); ml.Thickness=CH.LineThickness; ml.Color=CH.ColorStart:Lerp(CH.ColorEnd,p); ml.Visible=CH.Visible
            chOutlines[arm][seg]=ol; chLines[arm][seg]=ml
        end
    end
end

local function getCHTarget(center)
    local best,bestD=nil,CH.TrackingRadius
    for _,p in ipairs(Players:GetPlayers()) do
        if p==LocalPlayer or not p.Character then continue end
        local part=p.Character:FindFirstChild(CH.TrackPart)
        local hum=p.Character:FindFirstChildOfClass('Humanoid')
        if not part or not hum or hum.Health<=0 then continue end
        if CH.TeamCheck and p.Team==LocalPlayer.Team then continue end
        local sp,on=Camera:WorldToViewportPoint(part.Position)
        if on then
            local d=(Vector2.new(sp.X,sp.Y)-center).Magnitude
            if d<bestD then bestD=d; best=Vector2.new(sp.X,sp.Y) end
        end
    end
    return best
end

local BASE={0,math.pi/2,math.pi,math.pi*1.5}
local chAngle=0

RunService.RenderStepped:Connect(function()
    local screenCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local targetPos = screenCenter

    if CH.TrackingEnabled then 
        local t = getCHTarget(screenCenter)
        if t then targetPos = t end 
    end

    currentCHPosition = currentCHPosition:Lerp(targetPos, CH.TrackingSmoothness)

    if chCircle then
        chCircle.Position=currentCHPosition; chCircle.Radius=CH.CircleRadius
        chCircle.Color=CH.CircleColor; chCircle.Transparency=CH.CircleTransparency
        chCircle.Visible=CH.Visible and CH.CircleVisible
    end
    chAngle=chAngle+CH.SpinSpeed
    local segs=math.max(1,math.floor(CH.TotalLength/SEG))
    for arm=1,4 do
        local angle=BASE[arm]+chAngle
        local cos,sin=math.cos(angle),math.sin(angle)
        local AL,AO=chLines[arm],chOutlines[arm]
        if AL then
            for seg=1,#AL do
                local ml,ol=AL[seg],AO[seg]
                if ml and ol then
                    if CH.Visible then
                        local s1=CH.CentralGap+(seg-1)*SEG; local s2=CH.CentralGap+seg*SEG
                        local sP=currentCHPosition+Vector2.new(cos*s1,sin*s1)
                        local eP=currentCHPosition+Vector2.new(cos*s2,sin*s2)
                        ol.From=sP; ol.To=eP; ol.Thickness=CH.OutlineThickness; ol.Visible=true
                        ml.From=sP; ml.To=eP; ml.Thickness=CH.LineThickness
                        ml.Color=CH.ColorStart:Lerp(CH.ColorEnd,(seg-0.5)/segs); ml.Visible=true
                    else ml.Visible=false; ol.Visible=false end
                end
            end
        end
    end
end)

initCH()

-- ── Movement ──────────────────────────────────────────────────────
local speedEnabled=false; local walkSpeed=16
local jumpEnabled=false;  local jumpPower=50
local flying=false;       local flySpeed=50
local flyConn

local function applySpeed()
    local char=LocalPlayer.Character; if not char then return end
    local hum=char:FindFirstChildOfClass('Humanoid'); if not hum then return end
    hum.WalkSpeed=speedEnabled and walkSpeed or 16
end

local function applyJump()
    local char=LocalPlayer.Character; if not char then return end
    local hum=char:FindFirstChildOfClass('Humanoid'); if not hum then return end
    hum.UseJumpPower=true; hum.JumpPower=jumpEnabled and jumpPower or 50
end

local function toggleFly(on)
    flying=on
    local char=LocalPlayer.Character; if not char then return end
    local root=char:FindFirstChild('HumanoidRootPart'); if not root then return end
    if flying then
        flyConn=RunService.RenderStepped:Connect(function()
            local dir=Vector3.new(0,0,0); local cam=workspace.CurrentCamera
            if UserInputService:IsKeyDown(Enum.KeyCode.W)           then dir=dir+cam.CFrame.LookVector  end
            if UserInputService:IsKeyDown(Enum.KeyCode.S)           then dir=dir-cam.CFrame.LookVector  end
            if UserInputService:IsKeyDown(Enum.KeyCode.A)           then dir=dir-cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D)           then dir=dir+cam.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space)       then dir=dir+Vector3.new(0,1,0)     end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir-Vector3.new(0,1,0)     end
            root.Velocity=dir*flySpeed; root.RotVelocity=Vector3.new(0,0,0)
        end)
    else
        if flyConn then flyConn:Disconnect() end
        root.Velocity=Vector3.new(0,0,0)
    end
end

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if speedEnabled then applySpeed() end
    if jumpEnabled  then applyJump()  end
end)

-- ── Multi-Weather System (Rain & Snow) ────────────────────────────
local weatherEnabled = false
local selectedWeather = 'Rain'
local weatherIntensity = 31
local weatherColor = Color3.fromRGB(200, 220, 255)

local weatherFolder = workspace:FindFirstChild("CustomWeatherFolder") or Instance.new("Folder")
weatherFolder.Name = "CustomWeatherFolder"
weatherFolder.Parent = workspace

local weatherParticles = {}
local maxParticles = 120

for i = 1, maxParticles do
    local p = Instance.new("Part")
    p.Name = "WeatherParticle"
    p.Material = Enum.Material.SmoothPlastic
    p.Transparency = 0.4
    p.CanCollide = false
    p.Anchored = true
    p.CastShadow = false
    p.Parent = weatherFolder
    table.insert(weatherParticles, {Part = p, Active = false, Speed = 0, Drift = 0})
end

RunService.RenderStepped:Connect(function()
    if not weatherEnabled then
        for _, d in ipairs(weatherParticles) do
            if d.Active then
                d.Active = false
                d.Part.CFrame = CFrame.new(0, -1000, 0)
            end
        end
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local activeLimit = math.clamp(math.floor((weatherIntensity / 100) * maxParticles), 5, maxParticles)
    local center = hrp.Position

    for i = 1, maxParticles do
        local d = weatherParticles[i]
        if i <= activeLimit then
            if not d.Active or d.Part.Position.Y < (center.Y - 10) then
                local rx = math.random(-60, 60)
                local rz = math.random(-60, 60)
                local ry = math.random(20, 50)
                d.Part.CFrame = CFrame.new(center + Vector3.new(rx, ry, rz))
                d.Active = true

                if selectedWeather == 'Snow' then
                    d.Part.Size = Vector3.new(0.4, 0.4, 0.4)
                    d.Part.Shape = Enum.PartType.Ball
                    d.Speed = math.random(10, 25)
                    d.Drift = math.random(-5, 5) / 10
                else
                    d.Part.Size = Vector3.new(0.08, 2.5, 0.08)
                    d.Part.Shape = Enum.PartType.Block
                    d.Speed = math.random(80, 120)
                    d.Drift = 0
                end
            else
                d.Part.CFrame = d.Part.CFrame - Vector3.new(d.Drift, d.Speed * (1/60), 0)
                d.Part.Color = weatherColor
            end
        else
            if d.Active then
                d.Active = false
                d.Part.CFrame = CFrame.new(0, -1000, 0)
            end
        end
    end
end)

-- ── Working Self Chams & FOV System ──────────────────────────────
local selfChamsEnabled = false
local selfChamsStyle = 'Highlight'
local selfChamsGradient = false
local selfGradientSpeed = 5

local selfFillColor = Color3.fromRGB(255, 255, 255)
local selfOutlineColor = Color3.fromRGB(255, 255, 255)
local selfFillTrans = 0.5
local selfOutlineTrans = 0

local fovEnabled = false
local customFov = 90

local selfHue = 0
local savedState = {}
local isChamsActive = false

local function saveCharacterState(char)
    savedState = { Parts = {}, Clothing = {}, Textures = {} }
    for _, item in ipairs(char:GetDescendants()) do
        if item:IsA("BasePart") then
            savedState.Parts[item] = {
                Material = item.Material,
                Color = item.Color,
                Transparency = item.Transparency
            }
        elseif item:IsA("Clothing") or item:IsA("ShirtGraphic") then
            savedState.Clothing[item] = item.Parent
        elseif item:IsA("Decal") or item:IsA("Texture") then
            savedState.Textures[item] = item.Transparency
        end
    end
end

local function restoreCharacterState(char)
    if not isChamsActive then return end
    isChamsActive = false

    local highlight = char:FindFirstChild("SelfHighlight")
    if highlight then highlight:Destroy() end

    for part, data in pairs(savedState.Parts or {}) do
        if part and part.Parent then
            part.Material = data.Material
            part.Color = data.Color
            part.Transparency = data.Transparency
        end
    end

    for item, parent in pairs(savedState.Clothing or {}) do
        if item then item.Parent = parent end
    end

    for decal, trans in pairs(savedState.Textures or {}) do
        if decal and decal.Parent then decal.Transparency = trans end
    end

    savedState = {}
end

local function applySelfChams()
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    if not selfChamsEnabled then
        restoreCharacterState(char)
        return
    end

    if not isChamsActive then
        saveCharacterState(char)
        isChamsActive = true
    end

    local activeColor = selfFillColor
    if selfChamsGradient then
        activeColor = Color3.fromHSV(selfHue, 1, 1)
    end

    if selfChamsStyle == 'Highlight' then
        for item, parent in pairs(savedState.Clothing) do if item then item.Parent = parent end end
        for decal, trans in pairs(savedState.Textures) do if decal then decal.Transparency = trans end end
        for part, data in pairs(savedState.Parts) do
            if part then
                part.Material = data.Material
                part.Color = data.Color
                part.Transparency = data.Transparency
            end
        end

        local highlight = char:FindFirstChild("SelfHighlight") or Instance.new("Highlight")
        highlight.Name = "SelfHighlight"
        highlight.Adornee = char
        highlight.Enabled = true
        highlight.FillColor = activeColor
        highlight.OutlineColor = selfChamsGradient and activeColor or selfOutlineColor
        highlight.FillTransparency = selfFillTrans
        highlight.OutlineTransparency = selfOutlineTrans
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.Parent = char

    elseif selfChamsStyle == 'ForceField' or selfChamsStyle == 'Solid Color' then
        local highlight = char:FindFirstChild("SelfHighlight")
        if highlight then highlight:Destroy() end

        for item in pairs(savedState.Clothing) do if item then item.Parent = nil end end
        for decal in pairs(savedState.Textures) do if decal then decal.Transparency = 1 end end

        local targetMaterial = (selfChamsStyle == 'ForceField') and Enum.Material.ForceField or Enum.Material.SmoothPlastic

        for _, part in ipairs(char:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                part.Material = targetMaterial
                part.Color = activeColor
                part.Transparency = selfFillTrans
            elseif part:IsA("Accessory") then
                local handle = part:FindFirstChild("Handle")
                if handle and handle:IsA("BasePart") then
                    handle.Material = targetMaterial
                    handle.Color = activeColor
                    handle.Transparency = selfFillTrans
                end
            end
        end
    end
end

RunService.RenderStepped:Connect(function(deltaTime)
    if selfChamsGradient then
        selfHue = (selfHue + (deltaTime * selfGradientSpeed * 0.2)) % 1
    end

    applySelfChams()

    if fovEnabled then
        workspace.CurrentCamera.FieldOfView = customFov
    end
end)

LocalPlayer.CharacterAdded:Connect(function()
    isChamsActive = false
    savedState = {}
end)

-- ── Fixed ColorCorrection & Bloom System ──────────────────────────
local ccEffect = Lighting:FindFirstChild("CustomColorCorrection") or Instance.new("ColorCorrectionEffect")
ccEffect.Name = "CustomColorCorrection"
ccEffect.Parent = Lighting

local bloomEffect = Lighting:FindFirstChild("CustomBloom") or Instance.new("BloomEffect")
bloomEffect.Name = "CustomBloom"
bloomEffect.Parent = Lighting

local ccEnabled = false
local bloomEnabled = false

local function updateColorCorrection(brightness, contrast, saturation, tintColor)
    ccEffect.Enabled = ccEnabled
    if ccEnabled then
        ccEffect.Brightness = brightness
        ccEffect.Contrast = contrast
        ccEffect.Saturation = saturation
        ccEffect.TintColor = tintColor
    end
end

local function updateBloom(intensity, size, threshold)
    bloomEffect.Enabled = bloomEnabled
    if bloomEnabled then
        bloomEffect.Intensity = intensity
        bloomEffect.Size = size
        bloomEffect.Threshold = threshold
    end
end

