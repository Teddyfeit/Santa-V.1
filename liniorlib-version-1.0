local OriginalAmbient = Lighting.Ambient
local OriginalOutdoorAmbient = Lighting.OutdoorAmbient

local SkyboxPresets = {
    ['Purple Nebula'] = 'rbxassetid://159454299',
    ['Night Sky'] = 'rbxassetid://12064107',
    ['Pink Sky'] = 'rbxassetid://271042516',
    ['Sunset'] = 'rbxassetid://600832712'
}

local function applyHighlight(player)
    if player == LocalPlayer then return end
    
    local function setupCharacter(character)
        if not character then return end
        
        local highlight = character:FindFirstChild("CustomHighlight") or Instance.new("Highlight")
        highlight.Name = "CustomHighlight"
        highlight.Adornee = character
        
        highlight.Enabled = Toggles.Visuals_Enabled.Value
        highlight.FillColor = Options.Visuals_FillColor.Value
        highlight.OutlineColor = Options.Visuals_OutlineColor.Value
        highlight.FillTransparency = Toggles.Visuals_Fill.Value and Options.Visuals_FillTransparency.Value or 1
        highlight.OutlineTransparency = Toggles.Visuals_Outline.Value and Options.Visuals_OutlineTransparency.Value or 1
            
        highlight.Parent = character
    end

    if player.Character then setupCharacter(player.Character) end
    player.CharacterAdded:Connect(setupCharacter)
end

for _, player in ipairs(Players:GetPlayers()) do applyHighlight(player) end
Players.PlayerAdded:Connect(applyHighlight)

local hGradient = 0
local mainConnection

mainConnection = RunService.RenderStepped:Connect(function(deltaTime)
    if Library.Unloaded then
        if mainConnection then mainConnection:Disconnect() end
        return
    end

    if Toggles.Visuals_Gradient.Value then
        local speed = Options.Visuals_GradientSpeed.Value
        hGradient = (hGradient + (deltaTime * speed * 0.2)) % 1
    end

    local currentGradientColor = Color3.fromHSV(hGradient, 1, 1)

    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("CustomHighlight") then
            local hl = player.Character.CustomHighlight
            hl.Enabled = Toggles.Visuals_Enabled.Value
            
            if Toggles.Visuals_Gradient.Value then
                hl.FillColor = currentGradientColor
                hl.OutlineColor = currentGradientColor
            else
                hl.FillColor = Options.Visuals_FillColor.Value
                hl.OutlineColor = Options.Visuals_OutlineColor.Value
            end

            hl.FillTransparency = Toggles.Visuals_Fill.Value and Options.Visuals_FillTransparency.Value or 1
            hl.OutlineTransparency = Toggles.Visuals_Outline.Value and Options.Visuals_OutlineTransparency.Value or 1
        end
    end

    if Toggles.Ambient_Enabled.Value then
        Lighting.Ambient = Options.Ambient_Color.Value
        Lighting.OutdoorAmbient = Options.OutdoorAmbient_Color.Value
    else
        Lighting.Ambient = OriginalAmbient
        Lighting.OutdoorAmbient = OriginalOutdoorAmbient
    end
end)

local function updateSkybox()
    local currentSky = Lighting:FindFirstChildOfClass("Sky")
    
    if not Toggles.Skybox_Enabled.Value then
        if currentSky and currentSky.Name == "SantaCustomSky" then
            currentSky:Destroy()
        end
        return
    end

    if not currentSky or currentSky.Name ~= "SantaCustomSky" then
        currentSky = Instance.new("Sky")
        currentSky.Name = "SantaCustomSky"
        currentSky.Parent = Lighting
    end

    local selectedPreset = Options.Skybox_Preset.Value
    local customId = Options.Skybox_CustomID.Value
    local textureUri = ''

    if customId and customId ~= '' then
        textureUri = 'rbxassetid://' .. customId
    elseif SkyboxPresets[selectedPreset] then
        textureUri = SkyboxPresets[selectedPreset]
    end

    if textureUri ~= '' then
        currentSky.SkyboxBk = textureUri
        currentSky.SkyboxDn = textureUri
        currentSky.SkyboxFt = textureUri
        currentSky.SkyboxLf = textureUri
        currentSky.SkyboxRt = textureUri
        currentSky.SkyboxUp = textureUri
    end
end

Toggles.Skybox_Enabled:OnChanged(updateSkybox)
Options.Skybox_Preset:OnChanged(updateSkybox)
Options.Skybox_CustomID:OnChanged(updateSkybox)

local FrameCounter = 0
local LastGetFps = tick()
local CurrentFPS = 60

RunService.RenderStepped:Connect(function()
    FrameCounter = FrameCounter + 1
    if (tick() - LastGetFps) >= 1 then
        CurrentFPS = FrameCounter
        FrameCounter = 0
        LastGetFps = tick()
    end

    if WM_Config.Enabled then
        local parts = {}

        if WM_Config.Text ~= "" then
            table.insert(parts, WM_Config.Text)
        end

        if WM_Config.ShowFPS then
            table.insert(parts, string.format("%d fps", CurrentFPS))
        end

        if WM_Config.ShowPing then
            local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            table.insert(parts, string.format("%d ms", ping))
        end

        if WM_Config.ShowTime then
            table.insert(parts, os.date("%X"))
        end

        Library:SetWatermark(table.concat(parts, " | "))
    end
end)

