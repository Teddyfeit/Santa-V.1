-- ══════════════════════════════════════════════════════════════════
-- THEME - taken from LinoriaLib's Library table
-- ══════════════════════════════════════════════════════════════════
local FontColor = Color3.fromRGB(255, 255, 255)
local MainColor = Color3.fromRGB(28, 28, 28)
local BackgroundColor = Color3.fromRGB(20, 20, 20)
local AccentColor = Color3.fromRGB(0, 85, 255)
local OutlineColor = Color3.fromRGB(50, 50, 50)
local RiskColor = Color3.fromRGB(255, 50, 50)
local Black = Color3.new(0, 0, 0)
local FONT = Enum.Font.Code
local TEXTSIZE = 16

local TAG = "[KeySystem] "
local lastStage = "none"

local function stage(name)
    lastStage = name
    print(TAG .. "built: " .. name)
end

-- Key-Liste vom GitHub-Link abrufen
-- Gibt bei einem fehlgeschlagenen Request nil plus eine Meldung
-- zurück. Vorher lieferte der Fehlerfall eine leere Liste, wodurch
-- jeder Key als falsch gemeldet wurde.
local function FetchValidKeys()
    local success, response = pcall(function()
        return game:HttpGet(KeyURL)
    end)

    if not success or type(response) ~= "string" then
        return nil, "Could not reach the key server."
    end

    local keys = {}
    for line in response:gmatch("[^\r\n]+") do
        local cleanKey = line:match("^%s*(.-)%s*$")
        if cleanKey and #cleanKey > 0 and cleanKey:sub(1, 1) ~= "#" then
            table.insert(keys, cleanKey)
        end
    end

    if #keys == 0 then
        return nil, "The key list came back empty."
    end

    return keys
end

-- Funktion zum Prüfen, ob ein Key in der Liste existiert
local function IsKeyValid(keyToCheck, validKeys)
    for _, key in ipairs(validKeys) do
        if keyToCheck == key then
            return true
        end
    end
    return false
end

-- Schlüssel-Form: drei durch Bindestriche getrennte Gruppen aus
-- Buchstaben und Ziffern. Bewusst grosszuegig - die Funktion soll
-- nur offensichtliche Eingabefehler abfangen, keinen gueltigen Key
-- wegwerfen, weil jemand anders schreibt als hier dokumentiert.
local KEY_PATTERN = "^[%a][%w]*%-[%w]+%-[%w]+$"

-- ══════════════════════════════════════════════════════════════════
-- UI-Helfer
-- ══════════════════════════════════════════════════════════════════

-- LinoriaLib's ApplyTextStroke: a black outline instead of native text
-- stroke, with Miter joins. Set on every label for an exact match.
local function ApplyTextStroke(inst)
    inst.TextStrokeTransparency = 1

    local stroke = Instance.new("UIStroke")
    stroke.Color = Black
    stroke.Thickness = 1
    stroke.LineJoinMode = Enum.LineJoinMode.Miter
    stroke.Transparency = 0
    stroke.Parent = inst
    return stroke
end

local function label(props)
    local inst = Instance.new("TextLabel")
    inst.BackgroundTransparency = 1
    inst.Font = FONT
    inst.TextColor3 = FontColor
    inst.TextSize = TEXTSIZE
    ApplyTextStroke(inst)
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

local function box(class, props)
    local inst = Instance.new(class)
    inst.BorderSizePixel = 1
    inst.BorderColor3 = OutlineColor
    for k, v in pairs(props) do
        inst[k] = v
    end
    return inst
end

-- Dragging a Frame has to go through InputBegan / InputChanged /
-- InputEnded. There is NO InputMoved on a GuiObject - that event only
-- exists on UserInputService. frame.InputMoved:Connect threw
-- "InputMoved is not a valid member of Frame" on the line right after
-- the black Outer frame was created, killing the rest of the build.
-- That is exactly why the window appeared as an empty black box: the
-- one frame that had already been drawn, and nothing after it.
--
-- InputChanged fires continuously while the button is held, so the
-- position is recomputed from the original startPos on every move.
-- Recomputing from a fixed origin is what stops the drag drifting.
local function MakeDraggable(frame, cutoff)
    frame.Active = true

    local dragging = false
    local dragStart = Vector2.zero
    local startPos = UDim2.new()
    local endConnection = nil

    local function stopDragging()
        dragging = false
        if endConnection then
            endConnection:Disconnect()
            endConnection = nil
        end
    end

    frame.InputBegan:Connect(function(input)
        local kind = input.UserInputType
        if kind ~= Enum.UserInputType.MouseButton1
        and kind ~= Enum.UserInputType.Touch then
            return
        end

        dragging = true
        dragStart = input.Position
        startPos = frame.Position

        -- Zweite Sicherung: InputEnded kommt nicht immer an, wenn der
        -- Cursor waehrend des Ziehens aus dem Fenster faellt.
        endConnection = input.Changed:Connect(function()
            if input.State == Enum.UserInputState.End then
                stopDragging()
            end
        end)
    end)

    frame.InputChanged:Connect(function(input)
        if not dragging then return end

        local kind = input.UserInputType
        if kind ~= Enum.UserInputType.MouseMovement
        and kind ~= Enum.UserInputType.Touch then
            return
        end

        local delta = input.Position - dragStart
        local viewport = workspace.CurrentCamera.ViewportSize

        frame.Position = UDim2.new(
            startPos.X.Scale,
            math.clamp(startPos.X.Offset + delta.X, -cutoff, viewport.X - cutoff),
            startPos.Y.Scale,
            math.clamp(startPos.Y.Offset + delta.Y, -cutoff, viewport.Y - cutoff)
        )
    end)

    frame.InputEnded:Connect(stopDragging)
end

-- AUTOMATISCHER KEY-CHECK BEIM START
task.spawn(function()
    if readfile and isfile and isfile(SaveFileName) then
        local savedKey = readfile(SaveFileName):match("^%s*(.-)%s*$")
        if savedKey and #savedKey > 0 then
            print(TAG .. "Checking Saved Key")
            local validKeys, err = FetchValidKeys()
            if not validKeys then
                print(TAG .. "Saved Key check failed: " .. tostring(err))
            elseif IsKeyValid(savedKey, validKeys) then
                print(TAG .. "Saved Key has passed")
                ScriptToRun()
                return -- Beendet den Thread, damit keine UI geladen wird
            else
                print(TAG .. "Saved Key has failed")
                if delfile then delfile(SaveFileName) end -- Löscht ungültigen Key
            end
        end
    end

    -- UI ERSTELLEN (wird nur ausgeführt, wenn kein gültiger gespeicherter Key existiert)
    local function buildUI()
        local KeySystemUI = Instance.new("ScreenGui")
        KeySystemUI.Name = "KeySystemUI"
        KeySystemUI.Parent = PlayerGui
        KeySystemUI.ResetOnSpawn = false
        KeySystemUI.IgnoreGuiInset = true
        KeySystemUI.DisplayOrder = 500
        -- Global, wie LinoriaLib. Mit Sibling stapelt ein Kind nur gegen
        -- seine Geschwister, nicht gegen das Eltern-Frame - bei
        -- gleichem ZIndex ueberschreiben sich die Ebenen dann gegenseitig
        -- und der Inhalt verschwindet hinter dem Hintergrund.
        KeySystemUI.ZIndexBehavior = Enum.ZIndexBehavior.Global
        stage("ScreenGui")

        local WIDTH, HEIGHT = 420, 300

        -- Outer: pure black shell. Zwei Pixel kleiner als das Fenster
        -- darunter, damit die schwarze Kante wie bei LinoriaLib als
        -- Rahmen sichtbar bleibt statt alles zu ueberdecken.
        local Outer = box("Frame", {
            Name = "Outer",
            BackgroundColor3 = Black,
            Position = UDim2.fromScale(0.5, 0.5),
            AnchorPoint = Vector2.new(0.5, 0.5),
            Size = UDim2.fromOffset(WIDTH, HEIGHT),
            ZIndex = 1,
            Parent = KeySystemUI,
        })
        MakeDraggable(Outer, 60)
        stage("Outer")

        -- Inner: body with the 1px accent inset border
        local Inner = box("Frame", {
            Name = "Inner",
            BackgroundColor3 = MainColor,
            BorderColor3 = AccentColor,
            BorderMode = Enum.BorderMode.Inset,
            Position = UDim2.fromOffset(1, 1),
            Size = UDim2.new(1, -2, 1, -2),
            ZIndex = 2,
            Parent = Outer,
        })
        stage("Inner")

        local Title = label({
            Name = "Title",
            Position = UDim2.fromOffset(7, 0),
            Size = UDim2.new(1, -40, 0, 25),
            Text = "Key System",
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 3,
            Parent = Inner,
        })
        stage("Title")

        -- Muss ein TextButton sein, kein TextLabel. Ein TextLabel hat
        -- Active = false und BackgroundTransparency = 1, faengt also
        -- keinen Klick ab - der Klick ginge an Outer und wuerde das
        -- Fenster nur ziehen, ohne es zu schliessen.
        local CloseButton = box("TextButton", {
            Name = "Close",
            Font = FONT,
            TextColor3 = FontColor,
            TextSize = TEXTSIZE,
            AutoButtonColor = false,
            Active = true,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -6, 0, 4),
            Size = UDim2.fromOffset(16, 16),
            Text = "X",
            ZIndex = 4,
            Parent = Inner,
        })
        ApplyTextStroke(CloseButton)
        stage("CloseButton")

        -- Main content section, same 8px inset LinoriaLib uses
        local MainSectionOuter = box("Frame", {
            Name = "MainSectionOuter",
            BackgroundColor3 = BackgroundColor,
            BorderColor3 = OutlineColor,
            Position = UDim2.fromOffset(8, 25),
            Size = UDim2.new(1, -16, 1, -33),
            ZIndex = 3,
            Parent = Inner,
        })

        local MainSectionInner = box("Frame", {
            Name = "MainSectionInner",
            BackgroundColor3 = BackgroundColor,
            BorderColor3 = Black,
            BorderMode = Enum.BorderMode.Inset,
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 4,
            Parent = MainSectionOuter,
        })
        stage("MainSection")

        -- Groupbox, matching LinoriaLib's tab content styling
        local GroupboxOuter = box("Frame", {
            Name = "GroupboxOuter",
            BackgroundColor3 = MainColor,
            BorderColor3 = OutlineColor,
            Position = UDim2.fromOffset(6, 6),
            Size = UDim2.new(1, -12, 1, -12),
            ZIndex = 5,
            Parent = MainSectionInner,
        })

        local GroupboxInner = box("Frame", {
            Name = "GroupboxInner",
            BackgroundColor3 = MainColor,
            BorderColor3 = Black,
            BorderMode = Enum.BorderMode.Inset,
            Position = UDim2.fromOffset(0, 0),
            Size = UDim2.new(1, 0, 1, 0),
            ZIndex = 6,
            Parent = GroupboxOuter,
        })
        stage("Groupbox")

        local GroupboxLabel = label({
            Name = "GroupboxLabel",
            Position = UDim2.fromOffset(8, 4),
            Size = UDim2.new(1, -16, 0, 18),
            Text = "Authentication",
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 7,
            Parent = GroupboxInner,
        })
        stage("GroupboxLabel")

        local PAD = 20

        local KeyLabel = label({
            Name = "KeyLabel",
            Position = UDim2.fromOffset(PAD, 30),
            Size = UDim2.new(1, -PAD * 2, 0, 16),
            Text = "Key",
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 7,
            Parent = GroupboxInner,
        })
        stage("KeyLabel")

        -- Input: BackgroundColor fill with an OutlineColor border, which is
        -- exactly how LinoriaLib renders text inputs
        local KeyInputShell = box("Frame", {
            Name = "KeyInputShell",
            BackgroundColor3 = BackgroundColor,
            BorderColor3 = OutlineColor,
            Position = UDim2.fromOffset(PAD, 50),
            Size = UDim2.new(1, -PAD * 2, 0, 26),
            ZIndex = 7,
            Parent = GroupboxInner,
        })

        local KeyInput = box("TextBox", {
            Name = "KeyInput",
            BackgroundColor3 = BackgroundColor,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Font = FONT,
            TextColor3 = FontColor,
            TextSize = TEXTSIZE,
            Text = "",
            PlaceholderText = "SANTA-XXXX-XXXX",
            PlaceholderColor3 = OutlineColor,
            TextXAlignment = Enum.TextXAlignment.Left,
            ClearTextOnFocus = false,
            Size = UDim2.new(1, -10, 1, 0),
            Position = UDim2.fromOffset(4, 0),
            ZIndex = 8,
            Parent = KeyInputShell,
        })
        stage("KeyInput")

        local StatusLabel = label({
            Name = "Status",
            Position = UDim2.fromOffset(PAD, 84),
            Size = UDim2.new(1, -PAD * 2, 0, 16),
            Text = "",
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 7,
            Parent = GroupboxInner,
        })
        stage("Status")

        -- Button: fills with AccentColor on hover, like LinoriaLib buttons
        local SubmitButton = box("TextButton", {
            Name = "SubmitButton",
            BackgroundColor3 = BackgroundColor,
            BorderColor3 = OutlineColor,
            Position = UDim2.fromOffset(PAD, 108),
            Size = UDim2.new(1, -PAD * 2, 0, 28),
            Text = "Check Key",
            TextColor3 = FontColor,
            TextSize = TEXTSIZE,
            Font = FONT,
            AutoButtonColor = false,
            ZIndex = 7,
            Parent = GroupboxInner,
        })
        ApplyTextStroke(SubmitButton)
        stage("SubmitButton")

        local busy = false

        local function setStatus(text, colour)
            StatusLabel.Text = text
            StatusLabel.TextColor3 = colour or FontColor
        end

        local function setInputBorder(colour)
            TweenService:Create(KeyInputShell, TweenInfo.new(0.15), {
                BorderColor3 = colour,
            }):Play()
        end

        local function setButton(colour, text)
            SubmitButton.Text = text
            TweenService:Create(SubmitButton, TweenInfo.new(0.15), {
                BackgroundColor3 = colour,
            }):Play()
        end

        local function setButtonText(text)
            SubmitButton.Text = text
        end

        local function onSuccess(enteredKey)
            busy = true
            setStatus("Key passed.", AccentColor)
            setInputBorder(AccentColor)
            setButton(AccentColor, "Welcome")

            -- Key lokal auf dem PC speichern. Der getrimmte Wert wird
            -- gespeichert, nicht KeyInput.Text - sonst waere ein Key mit
            -- versehentlichen Leerzeichen beim naechsten Start ungueltig.
            if writefile then
                writefile(SaveFileName, enteredKey)
            end

            print(TAG .. "Key has passed")
            task.wait(1)

            -- UI Schließen & Ziel-Skript ausführen
            KeySystemUI:Destroy()
            ScriptToRun()
        end

        local function onFailure(message)
            busy = true
            setStatus(message, RiskColor)
            setInputBorder(RiskColor)
            setButton(RiskColor, "Wrong Key")
            task.wait(1.5)

            -- Falscher Key darf das Panel nicht schließen
            setInputBorder(OutlineColor)
            setButton(BackgroundColor, "Check Key")
            busy = false
        end

        local function attempt()
            if busy then return end

            local enteredKey = KeyInput.Text:match("^%s*(.-)%s*$")

            if not enteredKey or #enteredKey == 0 then
                onFailure("Enter a key first.")
                return
            end

            if not enteredKey:match(KEY_PATTERN) then
                onFailure("That is not a valid key format.")
                return
            end

            -- busy bleibt über den Request hinweg gesetzt, sonst startet
            -- ein zweiter Klick einen zweiten gleichzeitigen Versuch
            busy = true
            setButtonText("Checking Key...")
            setStatus("Verifying...", AccentColor)
            setInputBorder(AccentColor)

            local validKeys, err = FetchValidKeys()
            if not validKeys then
                onFailure(err or "Key check failed.")
                return
            end

            if IsKeyValid(enteredKey, validKeys) then
                onSuccess(enteredKey)
            else
                onFailure("Wrong key.")
            end
        end

        -- Logik zum Überprüfen & Speichern
        SubmitButton.MouseButton1Click:Connect(function()
            attempt()
        end)

        KeyInput.Focused:Connect(function()
            setInputBorder(AccentColor)
        end)

        KeyInput.FocusLost:Connect(function(enterPressed)
            setInputBorder(OutlineColor)
            if not busy and enterPressed then
                attempt()
            end
        end)

        SubmitButton.MouseEnter:Connect(function()
            if busy then return end
            setButton(AccentColor, SubmitButton.Text)
        end)

        SubmitButton.MouseLeave:Connect(function()
            if busy then return end
            setButton(BackgroundColor, SubmitButton.Text)
        end)

        CloseButton.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
                KeySystemUI:Destroy()
            end
        end)

        -- Einblenden. Kein Scale-Tween: LinoriaLib blendet seine Fenster
        -- nur über Transparency ein, und die scharfen Kanten machen jeden
        -- Zoom als Wackeln sichtbar.
        --
        -- TextTransparency gibt es nur auf TextLabel, TextButton und
        -- TextBox. Ein Lesezugriff auf einem Frame wirft "TextTransparency
        -- is not a valid member of Frame" und liefert kein nil, deshalb
        -- muss die Klasse geprueft werden - eine nil-Pruefung auf dem
        -- Property schuetzt nicht, weil der Fehler schon beim Lesen
        -- auftritt.
        local function fadeIn(root, time)
            local list = { root }
            for _, child in ipairs(root:GetDescendants()) do
                if child:IsA("GuiObject") then
                    table.insert(list, child)
                end
            end

            for _, obj in ipairs(list) do
                local props = { "BackgroundTransparency" }

                if obj:IsA("TextLabel") or obj:IsA("TextButton")
                or obj:IsA("TextBox") then
                    table.insert(props, "TextTransparency")
                end

                for _, prop in ipairs(props) do
                    local base = obj[prop]
                    obj[prop] = math.clamp(base + 0.6, 0, 1)
                    TweenService:Create(obj, TweenInfo.new(time), {
                        [prop] = base,
                    }):Play()
                end
            end
        end

        task.spawn(function()
            task.wait(0.1)
            fadeIn(Outer, 0.25)
        end)
    end

    local ok, err = pcall(buildUI)
    if ok then
        print(TAG .. "UI build finished, last element: " .. lastStage)
    else
        print(TAG .. "UI BUILD FAILED after: " .. lastStage)
        print(TAG .. "error = " .. tostring(err))
    end
end)
